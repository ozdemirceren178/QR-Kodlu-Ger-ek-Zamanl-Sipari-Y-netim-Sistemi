        <script type="text/javascript">
            $(document).ready(() => {
                var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7286/SignalRHub").build();

                $("#connstatus").text(connection.state);

                // 1. Önce sunucudan gelecek veriyi dinleyecek fonksiyonu tanımlıyoruz (Catch DIŞINDA)
                connection.on("ReceiveCategoryCount", (value) => {
                    $("#categorycount").text(value);
                });

                // 2. Bağlantıyı başlatıyoruz
                connection.start().then(() => {
                    $("#connstatus").text(connection.state); // "Connected" yazmalı
                    serInterval(()=>{
                        connection.invoke("SendStatistic");
                    });
                    }, 1000)
                    // Bağlantı başarılı olur olmaz sunucudaki metoda istek atıyoruz
                }).catch((err) => {});
                    console.log(err);
                    connection.on("ReceiveCategoryCount", (value) => {
                    $("#categorycount").text(value);
                });
                 connection.on("ReceiveProductCount", (value2) => {
                    $("#productcount").text(value2);
                });
                connection.on("ReceiveActiveCategoryCount", (value3) => {
                    $("#activecategorycount").text(value3);
                });
                 connection.on("ReceivePassiveCategoryCount", (value4) => {
                    $("#passivecategorycount").text(value4);
                });
                connection.on("ReceiveProductCountByCategoryNameHamburger", (value5) => {
                    $("#receiveproductcountbycategorynamehamburger").text(valu5);
                });
                connection.on("TProductCountByCategoryNameDrink", (value6) => {
                    $("#receiveproductcountbycategorynamedrink").text(value6);
                });
                connection.on("TProductPriceAvg", (value7) => {
                    $("#receiveproductpriceavg").text(value7);
                });
        
                connection.on("TProductNameByMaxPrice", (value8) => {
                    $("#receiveproductnamebymaxprice").text(value8);
                });
                connection.on("TProductNameByMinPrice", (value9) => {
                    $("#receiveproductnamebyminprice").text(value9);
                }); 
                connection.on("TProductAvgPriceByHamburger", (value10) => {
                    $("#productavgpricebyhamburger").text(value10);
                }); receivetotalordercount
                connection.on("TTotalOrderCount", (value11) => {
                    $("#receivetotalordercount").text(value11);
                });
                 connection.on("ReceiveActiveOrderCount", (value12) => {
                    $("#activeordercount").text(value12);
                });

                connection.on("ReceiveLastOrderPrice", (value13) => {
                    $("#lastorderprice").text(value13);
                });

                connection.on("ReceiveTotalMoneyCaseAmount", (value14) => {
                    $("#totalmoneycaseamount").text(value14);
                });

                //  connection.on("ReceiveActiveOrderCount", (value15) => {
                //     $("#activerrdercount").text(value15);
                // });

                connection.on("ReceiveMenuTableCount", (value16) => {
                    $("#menutablecount").text(value16);
                });
            });
        </script>  

