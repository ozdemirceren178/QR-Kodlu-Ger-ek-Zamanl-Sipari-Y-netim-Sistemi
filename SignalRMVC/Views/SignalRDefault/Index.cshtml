@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <!-- Kart içeriği -->
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8 offset-2">
        <div class="alert alert-success">Bağlantının Durumu: <strong id="connstatus">Bağlanıyor...</strong></div>
        <div class="alert alert-info">Kategori Sayısı: <strong id="categorycount"></strong></div>
    </div>
</div>

<!-- Gerekli Scriptler -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script type="text/javascript">
    $(document).ready(() => {
        var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7286/SignalRHub").build();

        $("#connstatus").text(connection.state);

        // 1. Önce sunucudan gelecek veriyi dinleyecek fonksiyonu tanımlıyoruz (Catch DIŞINDA)
        connection.on("ReceiveCategoryCount", (value) => {
            $("#categorycount").text(value);
        });

        // 2. Bağlantıyı başlatıyoruz
        connection.start().then(() => {
            $("#connstatus").text(connection.state); // "Connected" yazmalı

            // Bağlantı başarılı olur olmaz sunucudaki metoda istek atıyoruz
            connection.invoke("SendCategoryCount").catch((err) => {
                console.error(err);
            });

        }).catch((err) => {
            console.log(err);
            $("#connstatus").text("Bağlantı Başarısız!");
        });
    });
</script>