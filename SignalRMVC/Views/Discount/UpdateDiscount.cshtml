@model UpdateDiscountDto
@{
	ViewData["Title"] = "UpdateDiscount";
	Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">İndirimli Ürün İşlemleri</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title"> Hakkımızda Yazı Güncelleme Sayfası</div>
						</div>
						<input type="hidden" asp-for="DiscountID" />
						<div class="card-body">
							<div class="form-group">
								<label for="Title">Başlığı Giriniz</label>
								<input type="text" class="form-control" asp-for="Title" id="Title">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="ImageUrl">Görsel urlini girin Giriniz</label>
								<input type="text" class="form-control" asp-for="ImageURL" id="ImageUrl">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="Description">Açıklamayı Giriniz</label>
								<textarea rows="5" class="form-control" asp-for="Description"></textarea>
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-success">Kategori Ekle</button>

						</div>
					</div>
				</form>
			</div>

		</div>
	</div>
</div>



