@model UpdateProductDto
@{
    ViewData["Title"] = "UpdateProduct";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Güncelleme İşlemleri</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Ürün Güncelleme Sayfası</div>
						</div>
						<input type="hidden" asp-for="ProductID"/>
						<div class="card-body">
							<div class="form-group">
								<label for="productname">Güncelleme Adını Giriniz</label>
								<input type="text" class="form-control" asp-for="ProductName" id="productname">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="price">Güncelleme Fiyatını Giriniz</label>
								<input type="text" class="form-control" asp-for="Price" id="price">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="imageurl">Güncelleme Görselini Ekleyiniz</label>
								<input type="text" class="form-control" asp-for="ImageURL" id="imageurl">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="price">Güncelleme Kategorisini Seçiniz </label>
								@Html.DropDownListFor(x => x.CategoryID, (List<SelectListItem>)ViewBag.v, new { @class = "form-control" })
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="description">Güncelleme Açıklamasını Yazınız</label>
								<input type="text" class="form-control" asp-for="Description" id="description">

							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-success">Ürünü Güncelle</button>

						</div>
					</div>
				</form>
			</div>

		</div>
	</div>
</div>


